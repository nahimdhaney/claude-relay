{
  "permissions": {"allow": ["Bash(git status)"]},
  "statusLine": {"type": "command", "command": "printf 'superset-status'", "padding": 2},
  "hooks": {
    "Stop": [{"hooks": [{"type": "command", "command": "superset stop"}]}],
    "Notification": [{"matcher": "*", "hooks": [{"type": "command", "command": "superset notify"}]}],
    "SessionStart": [{"hooks": [{"type": "command", "command": "superset start"}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "superset end"}]}],
    "PreToolUse": [{"matcher": "Bash", "hooks": [{"type": "command", "command": "superset pre"}]}],
    "PostToolUse": [{"matcher": "Edit", "hooks": [{"type": "command", "command": "superset post", "timeout": 10}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "superset prompt"}]}],
    "StopFailure": [{"matcher": "*", "hooks": [{"type": "command", "command": "superset failure"}]}]
  }
}
